# 复制为 .env 后按需修改（.env 不会提交到 git）
APP_NAME=CRM-OKR System
DEBUG=true
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./app.db
# 生产 / 本机 PostgreSQL 示例（psycopg 3）：
# DATABASE_URL=postgresql+psycopg://postgres:your_password@127.0.0.1:5432/crm_okr
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 线索公海规则（可选覆盖）
# LEAD_PROTECT_DAYS=15
# LEAD_RETURN_COOLDOWN_HOURS=24
# LEAD_DAILY_CLAIM_LIMIT=20
# LEAD_PROTECT_HOLD_LIMIT=100

# 飞书网页应用登录（开放平台：凭证与基础信息 + 安全设置重定向 URL）
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=xxx
# FEISHU_REDIRECT_URI=http://127.0.0.1:5173/login/feishu/callback
# 正式环境建议 false：仅已绑定 feishu_open_id（或邮箱匹配）的用户可登录
# FEISHU_AUTO_PROVISION=false
# FEISHU_SCOPE=contact:user.base:readonly
# 通讯录同步还需开通：获取通讯录基本信息 / 以应用身份读取通讯录，并配置通讯录权限范围
# 考勤同步还需开通：导出打卡数据（attendance:task:readonly）；查询用 employee_id/employee_no，不支持 open_id
# 查根部门 0 要求范围为「全部成员」；若仅开放指定部门，填该部门的 open_department_id
# FEISHU_CONTACT_ROOT_DEPARTMENT_ID=0

# AI 知识库 RAG：DeepSeek 云 API（https://platform.deepseek.com 创建 Key）
# 不填 LLM_API_KEY 时问答仅做关键词检索拼接，不调用大模型
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_TIMEOUT_SECONDS=45
